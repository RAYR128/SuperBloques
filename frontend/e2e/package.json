{
	"name": "superbloques-e2e",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.1.2",
	"scripts": {
		"build:editor": "pnpm --dir ../editor build",
		"pretest": "pnpm run build:editor",
		"pretest:headed": "pnpm run build:editor",
		"pretest:ui": "pnpm run build:editor",
